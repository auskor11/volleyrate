<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>app.volleyrate.backup</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string><string>-lc</string>
    <string>cd ~/Codes/Projects/volleyrate &amp;&amp; npm run --silent backup >> private/backups/backup.log 2>&amp;1</string>
  </array>
  <!-- every Sunday at 12:00; if the Mac was asleep then, it runs when it next wakes -->
  <key>StartCalendarInterval</key>
  <dict><key>Weekday</key><integer>0</integer><key>Hour</key><integer>12</integer><key>Minute</key><integer>0</integer></dict>
</dict>
</plist>
