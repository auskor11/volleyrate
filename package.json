{
  "name": "volleyrate",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "backup": "node scripts/backup-db.mjs",
    "shrink": "zsh scripts/shrink-video.sh",
    "test:rules": "node scripts/test-rules.mjs",
    "restore": "node scripts/restore-db.mjs",
    "ratings:snapshot": "node scripts/ratings-check.mjs snapshot",
    "ratings:diff": "node scripts/ratings-check.mjs diff",
    "sync-detector": "cp rally-lab/web/{worker.js,analyze.js,detect.js,model.json,train_base.json} public/detector/ && cp rally-lab/web/vendor/* public/detector/vendor/"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.3",
    "firebase": "^13.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "firebase-tools": "^14.27.0",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
