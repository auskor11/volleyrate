rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function email() {
      return request.auth.token.email.lower();
    }
    function memberPath() {
      return /databases/$(database)/documents/members/$(email());
    }
    // Bootstrap admins, stored as SHA-256 hashes of their lowercase emails (same list as
    // OWNER_HASHES in src/lib/auth.tsx) so the repo doesn't publish the addresses.
    function isOwner() {
      return signedIn() && hashing.sha256(email()).toHexString().lower() in [
        '7d99c35cf45491553a917b4658ff4c2d36e7e3268b6886e47480ab41bb1ad19d',
        '225af8a3e6040d8d88b6d773d016a5ed74c673827a3454c337f43d7e3ff236b5'
      ];
    }
    function isAdmin() {
      return isOwner() || (signedIn() && exists(memberPath()) && get(memberPath()).data.get('role', 'player') == 'admin');
    }
    function isMember() {
      return isAdmin() || (signedIn() && exists(memberPath()));
    }
    // Roles: admin; player (the default: everything below); editor (reviews and tags games); viewer (watch only)
    function role() {
      return get(memberPath()).data.get('role', 'player');
    }
    function isPlayer() {
      return isAdmin() || (signedIn() && exists(memberPath()) && role() == 'player');
    }
    function canEdit() {
      return isPlayer() || (signedIn() && exists(memberPath()) && role() == 'editor');
    }

    // Team list: doc id = lowercase Google email -> { playerId, role }
    // Each person may stamp their own "last seen" (the server's time, nothing else); admins change the rest.
    match /members/{memberEmail} {
      allow get: if signedIn() && (memberEmail == email() || isAdmin());
      allow list: if isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        signedIn() && memberEmail == email()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeen'])
        && request.resource.data.lastSeen == request.time
      );
    }

    // Players can change the positions on their own profile (primary first), and anyone on the team can
    // change anyone's face photo (a small image, stored inline); nothing else.
    // Guests (no sign-in) can watch: games, players and the ratings settings are public. Nothing public
    // holds an email (games record first names). Members, highlights, history and backups stay private.
    match /players/{playerId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isPlayer()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['photo', 'photoBy'])
        && (!('photo' in request.resource.data) || (request.resource.data.photo is string
            && request.resource.data.photo.size() < 150000
            && request.resource.data.photo.matches('^data:image/(webp|jpeg);base64,[A-Za-z0-9+/=]+$')))
        && (!('photoBy' in request.resource.data) || (request.resource.data.photoBy is string && request.resource.data.photoBy.size() < 60))
      ) || (
        signedIn() && exists(memberPath()) && get(memberPath()).data.get('playerId', '') == playerId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['positions'])
        && request.resource.data.positions is list
        && request.resource.data.positions.size() >= 1 && request.resource.data.positions.size() <= 5
        && request.resource.data.positions.hasOnly(['S', 'OH', 'OPP', 'MB', 'L'])
      );
    }

    // Highlights: whole rallies bookmarked to a player's profile. Anyone on the team can add one
    // (as themselves); the person who added it, the player it belongs to, or an admin can remove it.
    match /highlights/{id} {
      allow read: if isMember();
      allow create: if isPlayer() && request.resource.data.by == email();
      allow delete: if isAdmin() || resource.data.by == email()
        || (exists(memberPath()) && get(memberPath()).data.get('playerId', '') == resource.data.playerId);
    }

    // Detector data per game (contact sounds, rally candidates, serve signatures): the game page and Admin
    // training read it; whoever can edit games writes it. Kept out of the public game records to keep them light.
    match /gameData/{gameId} {
      allow read: if isMember();
      allow create, update: if canEdit();
      allow delete: if isAdmin();
    }

    // Access requests: someone signed in who isn't on the list asks to be an editor or a player
    // (doc id = their email). They can see and withdraw their own; admins see all and approve or dismiss.
    match /accessRequests/{reqEmail} {
      allow get: if signedIn() && (reqEmail == email() || isAdmin());
      allow list: if isAdmin();
      allow delete: if signedIn() && (reqEmail == email() || isAdmin());
      allow create, update: if signedIn() && reqEmail == email() && !exists(memberPath())
        && request.resource.data.keys().hasOnly(['name', 'want', 'playerId', 'note', 'at'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 80
        && request.resource.data.want in ['editor', 'player']
        && (!('playerId' in request.resource.data) || (request.resource.data.playerId is string && request.resource.data.playerId.size() <= 60))
        && (!('note' in request.resource.data) || (request.resource.data.note is string && request.resource.data.note.size() <= 200))
        && request.resource.data.at == request.time;
    }

    // Rating backups (Admin → Ratings → Backups)
    match /ratingBackups/{id} {
      allow read, write: if isAdmin();
    }

    // App settings, e.g. config/detector = the active rally-detector model. Admins change them.
    match /config/{key} {
      allow read: if key == 'ratingsEngine' || isMember();
      allow write: if isAdmin();
    }

    // Games: everyone on the list watches; players add games; players and editors review and tag them;
    // only admins delete.
    match /games/{gameId} {
      allow read: if true;
      allow create: if isPlayer();
      allow update: if canEdit();
      allow delete: if isAdmin();

      // who changed what: whoever can edit adds entries, nobody can edit or remove them
      match /history/{entryId} {
        allow read: if isMember();
        allow create: if canEdit();
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
